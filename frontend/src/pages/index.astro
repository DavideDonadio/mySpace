---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const homePath = getRelativeLocaleUrl(locale, "");

interface ApiPost {
  id: number;
  title: string;
  body: string;
  tags: string[];
  created_at: string;
  updated_at: string;
}

let apiPosts: ApiPost[] = [];

try {
  const res = await fetch("http://127.0.0.1:8000/posts?limit=3");
  if (res.ok) {
    const data = await res.json();
    apiPosts = data.items;
  }
} catch (error) {
  console.error("FastAPI server offline or unreachable:", error);
}
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        Welcome to mySpace
      </h1>{" "}
      <a
        target="_blank"
        href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
        class="inline-block"
        aria-label="RSS Feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <p>
        mySpace is my digital corner, here you will find articles about anything
        that i like or i am passionate about. The idea started from the desire
        to learn more about FastAPI, Astro and Tailwind CSS. <br /><br />
        Enjoy your stay.
      </p>
      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    <!-- Live Posts from FastAPI + SQLite -->
    <section id="database-posts" class="border-border border-b pt-12 pb-6">
      <h3 class="text-center text-3xl font-semibold tracking-wide">
        Recently on My Mind 💭
      </h3>

      {
        apiPosts.length === 0 ? (
          <p class="text-muted-foreground mt-4 text-sm">
            No posts found in SQLite database.
          </p>
        ) : (
          <ul class="mt-4 space-y-4">
            {apiPosts.map(post => (
              <li class="my-4">
                <h3 class="text-xl font-medium decoration-dashed hover:underline">
                  <a href={"/posts/" + post.id}>{post.title}</a>
                </h3>
                <p class="mt-1 text-sm opacity-80">{post.body}</p>
                <span class="mt-1 block text-xs opacity-60">
                  Published: {new Date(post.created_at).toLocaleDateString()}
                </span>
                <div class="mt-2 flex flex-wrap gap-2">
                  {post.tags.map(tag => (
                    <span class="bg-accent/10 text-accent rounded px-2 py-0.5 text-xs font-medium">
                      #{tag}
                    </span>
                  ))}
                </div>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
